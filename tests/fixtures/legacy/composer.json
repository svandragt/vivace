{
    "name": "vivace/fixture-legacy",
    "license": "proprietary",
    "type": "project",
    "version": "1.0.0",
    "require": {
        "pear/console_getopt": "^1.4",
        "swiftmailer/swiftmailer": "^5.4",
        "ezyang/htmlpurifier": "^4.17",
        "symfony/polyfill-mbstring": "^1.31",
        "symfony/polyfill-php80": "^1.31",
        "ramsey/uuid": "^3.9",
        "symfony/yaml": "2.6.*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-0": { "Legacy\\": "src-psr0/" },
        "psr-4": { "App\\Legacy\\": "src-psr4/" }
    },
    "autoload-dev": {
        "psr-4": { "App\\Legacy\\Tests\\": "tests-legacy/" },
        "classmap": [ "tests-legacy/classmap/" ],
        "exclude-from-classmap": [ "/tests-legacy/classmap/Excluded/" ]
    },
    "config": {
        "autoloader-suffix": "VivaceLegacy",
        "platform-check": true
    }
}
