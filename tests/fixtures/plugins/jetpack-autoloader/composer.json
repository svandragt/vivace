{
    "name": "vivace/fixture-jetpack-autoloader",
    "license": "proprietary",
    "type": "project",
    "repositories": [
        {"type": "path", "url": "packages/jetpack-autoloader", "options": {"versions": {"automattic/jetpack-autoloader": "6.0.2"}, "symlink": false}},
        {"type": "path", "url": "packages/psr4-lib", "options": {"versions": {"acme/psr4-lib": "1.0.0"}, "symlink": false}},
        {"type": "path", "url": "packages/classmap-lib", "options": {"versions": {"acme/classmap-lib": "1.2.0"}, "symlink": false}},
        {"type": "path", "url": "packages/files-lib", "options": {"versions": {"acme/files-lib": "2.0.1"}, "symlink": false}},
        {"type": "path", "url": "packages/psr0-lib", "options": {"versions": {"acme/psr0-lib": "0.9.0"}, "symlink": false}},
        {"type": "path", "url": "packages/dev-lib", "options": {"versions": {"acme/dev-lib": "1.0.0"}, "symlink": false}}
    ],
    "require": {
        "automattic/jetpack-autoloader": "6.0.2",
        "acme/psr4-lib": "1.0.0",
        "acme/classmap-lib": "1.2.0",
        "acme/files-lib": "2.0.1",
        "acme/psr0-lib": "0.9.0"
    },
    "require-dev": {
        "acme/dev-lib": "1.0.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "automattic/jetpack-autoloader": true
        }
    }
}
