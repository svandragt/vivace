{
    "name": "acme/drupal-scaffold-override",
    "type": "drupal-module",
    "extra": {
        "drupal-scaffold": {
            "file-mapping": {
                "[web-root]/index.php": "assets/index-override.php",
                "[web-root]/settings-extra.php": {
                    "append": "assets/settings-append.php"
                },
                "[web-root]/router.php": {
                    "prepend": "assets/router-prepend.php"
                },
                "[web-root]/.htaccess": false
            }
        }
    }
}
