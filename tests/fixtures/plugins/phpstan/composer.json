{
    "name": "vivace/fixture-phpstan",
    "license": "proprietary",
    "type": "project",
    "repositories": [
        {
            "type": "path",
            "url": "packages/ext-a",
            "options": {
                "versions": {
                    "acme/phpstan-ext-a": "1.0.0"
                }
            }
        },
        {
            "type": "path",
            "url": "packages/ext-b",
            "options": {
                "versions": {
                    "acme/phpstan-ext-b": "1.0.0"
                }
            }
        }
    ],
    "require": {
        "phpstan/phpstan": "^1.11",
        "phpstan/phpstan-strict-rules": "^1.6",
        "phpstan/extension-installer": "^1.4",
        "acme/phpstan-ext-a": "1.0.0",
        "acme/phpstan-ext-b": "1.0.0"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "autoloader-suffix": "VivaceFixture"
    }
}
